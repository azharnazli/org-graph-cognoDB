# --- Server ---
# Port the Express server listens on.
PORT=3000

# Runtime mode: "development" | "production" | "test"
NODE_ENV=development

# --- CognoDB (graph database) ---
# Bolt+s URI from the CognoDB Cloud console, e.g.
#   bolt+s://abc123.databases.cognodb.cloud
COGNODB_URI=

# Username is always "cognodb" for free-tier instances.
COGNODB_USER=cognodb

# Password shown ONCE at instance creation — paste it here.
COGNODB_PASSWORD=

# --- CORS ---
# Comma-separated list of origins allowed to call the API.
# In dev: the Vite dev server (default http://localhost:5173).
# In prod: the public URL of the deployed frontend.
CORS_ORIGIN=http://localhost:5173

# --- Logging ---
# One of: error | warn | info | http | debug
LOG_LEVEL=info
